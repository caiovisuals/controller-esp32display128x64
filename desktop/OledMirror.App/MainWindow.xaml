<Window x:Class="OledMirror.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OledMirror.App"
        Title="OledMirror - espelhamento de tela em OLED 128x64"
        Height="760" Width="1080" MinHeight="620" MinWidth="920"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BoolToBrushConverter x:Key="BoolToBrush" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                         Fill="{Binding IsConnected, Converter={StaticResource BoolToBrush}}" />
                <TextBlock Text="{Binding ConnectionStatus}" Margin="8,0,20,0" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DeviceDescription}" Foreground="{StaticResource TextDim}" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>
                <GroupBox Header="Conexao">
                    <StackPanel>
                        <TextBlock Text="Porta serial" Style="{StaticResource Label}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Ports}"
                                      SelectedItem="{Binding SelectedPort}" DisplayMemberPath="." />
                            <Button Grid.Column="1" Content="Buscar" MinWidth="70" Margin="6,3,0,3"
                                    Command="{Binding RefreshPortsCommand}" />
                        </Grid>
                        <TextBlock Text="Baud" Style="{StaticResource Label}" Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate}" />
                        <CheckBox Content="Reconectar automaticamente" IsChecked="{Binding AutoReconnect}" />
                        <CheckBox Content="Simular ESP32 (sem hardware)" IsChecked="{Binding SimulateDevice}" />
                        <Button Content="Reconectar" Command="{Binding ReconnectCommand}" Margin="0,6,0,0"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Fonte">
                    <StackPanel>
                        <TextBlock Text="Tipo" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding SourceKinds}" SelectedItem="{Binding SourceKind}" />
                        <StackPanel Visibility="{Binding IsMonitorSource, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Monitor" Style="{StaticResource Label}" Margin="0,8,0,0" />
                            <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsWindowSource, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Janela" Style="{StaticResource Label}" Margin="0,8,0,0" />
                            <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsRegionSource, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Regiao (x, y, largura, altura)" Style="{StaticResource Label}" Margin="0,8,0,4" />
                            <UniformGrid Columns="4">
                                <TextBox Text="{Binding RegionX, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                <TextBox Text="{Binding RegionY, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                <TextBox Text="{Binding RegionWidth, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                <TextBox Text="{Binding RegionHeight, UpdateSourceTrigger=LostFocus}" />
                            </UniformGrid>
                        </StackPanel>
                        <Button Content="Atualizar listas" Command="{Binding RefreshSourcesCommand}"
                                Margin="0,8,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Imagem">
                    <StackPanel>
                        <TextBlock Text="Modo de encaixe" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding ResizeModes}" SelectedItem="{Binding ResizeMode}" />
                        <TextBlock Text="Dithering" Style="{StaticResource Label}" Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{Binding DitheringModes}" SelectedItem="{Binding Dithering}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Label}">
                            <Run Text="Limiar:" /><Run Text="{Binding Threshold}" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="255" Value="{Binding Threshold}" />
                        <CheckBox Content="Auto-contraste" IsChecked="{Binding AutoContrast}" />
                        <CheckBox Content="Inverter imagem" IsChecked="{Binding Invert}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Transmissao">
                    <StackPanel>
                        <TextBlock Text="FPS solicitado" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding TargetFps}" />

                        <TextBlock Text="Codificacao" Style="{StaticResource Label}" Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding Encoding}" />

                        <CheckBox Content="Nao reenviar frames iguais" IsChecked="{Binding SkipUnchangedFrames}" />
                        <CheckBox Content="Somente previa (nao envia ao ESP32)" IsChecked="{Binding PreviewOnly}" />

                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Label}">
                            <Run Text="Brilho do painel:" /><Run Text="{Binding DisplayContrast}" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="255" Value="{Binding DisplayContrast}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Diagnostico">
                    <WrapPanel>
                        <Button Content="HELLO WORLD" Command="{Binding SendHelloCommand}" Margin="0,0,6,6" />
                        <Button Content="Padrao teste" Command="{Binding SendTestPatternCommand}" Margin="0,0,6,6" />
                        <Button Content="Limpar painel" Command="{Binding ClearDisplayCommand}" Margin="0,0,6,6" />
                        <Button Content="Salvar config" Command="{Binding SaveSettingsCommand}" Margin="0,0,6,6" />
                    </WrapPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="4" Padding="16">
                <StackPanel>
                    <TextBlock Text="PREVIA DO PAINEL (128 x 64)" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" />
                    <Border Background="Black" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Padding="8" HorizontalAlignment="Center">
                        <Image x:Name="PreviewImage" Width="512" Height="256"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               SnapsToDevicePixels="True" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="METRICAS" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolucao de origem" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceResolution}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Resolucao de saida" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding OutputResolution}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="FPS solicitado" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TargetFps}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="FPS efetivo" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding EffectiveFps}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Latencia" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Latency}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Banda" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Bandwidth}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Frames enviados" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FramesSent}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Bytes enviados" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding BytesSent}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Erros" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Errors}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Tempos" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Timings}" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Iniciar" Command="{Binding StartCommand}"
                        Background="{StaticResource Accent}" Foreground="White" FontWeight="SemiBold" />
                <Button Content="Parar" Command="{Binding StopCommand}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="4" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,0,4,6">
                    <TextBlock Text="LOG" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
                    <Button Content="Limpar" Command="{Binding ClearLogCommand}" MinWidth="70"
                            Padding="8,2" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                </DockPanel>
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding LogEntries}"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDim}"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</Window>